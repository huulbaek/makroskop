# Python (etl)
etl/.venv/
__pycache__/
*.pyc

# Shock GDX drop folder: binary model output, regenerate or fetch — not versioned
etl/shock_gdx/*.gdx

# Node / SvelteKit (app)
app/node_modules/
app/.svelte-kit/
app/build/

# OS
.DS_Store

# freesolver parse cache (regenerate with: uv run python freesolver.py parse)
etl/cache/

# cloud bundle (packed + unpacked)
makroskop-cloud.tar.gz
makroskop-cloud/
etl/*.log

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# beads runtime db (export via bd export is versioned instead)
.beads/*.db
.beads/*.db-*
.playwright-mcp/

# beads audit log (append-only interaction log, local-only)
.beads/interactions.jsonl
etl/shock_gdx_dreamsize/*.gdx
